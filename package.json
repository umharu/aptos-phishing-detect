{
  "name": "@umharu/aptos-phishing-detect",
  "version": "0.1.0",
  "description": "Community-maintained phishing detection lists and utilities for the Aptos ecosystem.",
  "keywords": [
    "aptos",
    "phishing",
    "security",
    "petra",
    "wallet",
    "blocklist",
    "allowlist",
    "scam-detection",
    "web3-security"
  ],
  "homepage": "https://github.com/umharu/aptos-phishing-detect#readme",
  "bugs": {
    "url": "https://github.com/umharu/aptos-phishing-detect/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umharu/aptos-phishing-detect.git"
  },
  "license": "MIT",
  "author": "maximilian0.eth",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./data/blocklist.json": "./data/blocklist.json",
    "./data/allowlist.json": "./data/allowlist.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "validate": "tsx scripts/validate.ts",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run validate && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
